3. Skip-gram Model

import tensorflow as tf, numpy as np

c = ["I like playing football with my friends", "I enjoy playing tennis", "I hate swimming", "I love 

basketball"]

w, d, b, e = 3, 50, 16, 100

t = tf.keras.preprocessing.text.Tokenizer(); t.fit_on_texts(c)

s = t.texts_to_sequences(c); v = len(t.word_index)+1

p = [[w, s[j]] for s in s for i, w in enumerate(s) for j in range(max(0,i-w),min(len(s),i+w+1)) if i!=j]

x, y = np.array(p)[:,0], np.array(p)[:,1]

i = tf.keras.Input((1,))

o = tf.keras.layers.Dense(v, 

activation='softmax')(tf.keras.layers.Flatten()(tf.keras.layers.Embedding(v, d)(i)))

m = tf.keras.Model(i, o); m.compile('adam', 'sparse_categorical_crossentropy')

m.fit(x, y, b, e)

vec = m.layers[1].get_weights()[0]

print("\nVector for 'football':", vec[t.word_index['football']])

print("\nContext for 'playing':", [k for k, i in t.word_index.items() if abs(i - t.word_index['playing']) 

<= w and i != t.word_index['playing']])
