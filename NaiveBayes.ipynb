2.Naive Bayes

import tensorflow as tf, tensorflow_probability as tfp, numpy as np, matplotlib.pyplot as plt

from sklearn import datasets, model_selection; from sklearn.metrics import accuracy_score

tfd = tfp.distributions

x, y = datasets.load_iris(return_X_y=True); x = x[:, :2]

x_train, x_test, y_train, y_test = model_selection.train_test_split(x, y, test_size=0.2)

# Plot training data

plt.figure(); [plt.scatter(*x_train[y_train==i].T, label=f"Class {i}") for i in np.unique(y)]

plt.xlabel("Sepal length"); plt.ylabel("Sepal width"); plt.title("Training set"); plt.legend(); plt.show()

# Learn parameters

mus = tf.Variable([[1., 1.]] * 3); scales = tf.Variable([[1., 1.]] * 3)

opt = tf.keras.optimizers.Adam(0.01)

dist = tfp.distributions.MultivariateNormalDiag(loc=mus, scale_diag=scales)

def train_step(x, y):

with tf.GradientTape() as tape:

lp = dist.log_prob(tf.expand_dims(tf.cast(x, tf.float32), 1))

loss = -tf.reduce_mean(lp * tf.one_hot(y, 3))

opt.apply_gradients(zip(tape.gradient(loss, dist.trainable_variables), dist.trainable_variables))

return loss

for _ in range(1000): train_step(x_train, y_train)

print("Class conditional means:\n", dist.loc.numpy())

print("\nClass conditional standard deviations:\n", dist.stddev().numpy())

# Predict

prior = tfp.distributions.Categorical(probs=np.bincount(y_train)/len(y_train))

x_test_t = tf.expand_dims(tf.cast(x_test, tf.float32), 1)

probs = dist.prob(x_test_t) * tf.cast(prior.probs_parameter(), tf.float32)

print("\nTest accuracy: {:.4f}".format(accuracy_score(y_test, tf.argmax(probs, axis=1))))
