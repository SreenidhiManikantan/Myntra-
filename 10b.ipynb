import torch

from torchvision.models.detection import fasterrcnn_resnet50_fpn

from torchvision.transforms import functional as F

from PIL import Image

import matplotlib.pyplot as plt

import matplotlib.patches as patches

# Load model

model = fasterrcnn_resnet50_fpn(pretrained=True)

model.eval()

# Load and prepare image

img = Image.open("h1.png").convert("RGB")

img_tensor = F.to_tensor(img).unsqueeze(0)

# Get predictions
with torch.no_grad():

preds = model(img_tensor)

# Filter for humans (label 1) with high confidence

boxes = preds[0]['boxes']

labels = preds[0]['labels']

scores = preds[0]['scores']

humans = [box for i, box in enumerate(boxes) if labels[i] == 1 and scores[i] >␣

↪0.8]

# Show image with boxes

fig, ax = plt.subplots()

ax.imshow(img)

for box in humans:

x1, y1, x2, y2 = box

ax.add_patch(patches.Rectangle((x1, y1), x2-x1, y2-y1, edgecolor='red',␣

↪facecolor='none', linewidth=2))

plt.axis('off')

plt.show()
