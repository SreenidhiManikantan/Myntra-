#4.b Object detection(video) import cv2
import numpy as np


# Load YOLO model files
net = cv2.dnn.readNet("yolov4.weights", "yolov4.cfg") layer_names = net.getLayerNames()
output_layers = [layer_names[i - 1] for i in net.getUnconnectedOutLayers()]


# Load class names (COCO dataset) with open("coco.names", "r") as f:
classes = [line.strip() for line in f.readlines()]


# Initialize video capture (for traffic analysis from a video file or camera)
cap = cv2.VideoCapture("traffic_video.mp4") # Replace with your video file or 0 for webcam


# Process frames while True:
ret, frame = cap.read() if not ret:
break

# Resize frame and prepare it for YOLO (Make sure the size is 416x416) blob = cv2.dnn.blobFromImage(frame, 0.00392, (416, 416), (0, 0, 0), True,
crop=False)

net.setInput(blob)


# Get predictions
outs = net.forward(output_layers)


# Initialize lists to hold the detected objects class_ids = []
confidences = [] boxes = []

# Process detections for out in outs:
for detection in out: scores = detection[5:]
class_id = np.argmax(scores) confidence = scores[class_id]

if confidence > 0.5: # Confidence threshold center_x = int(detection[0] * frame.shape[1]) center_y = int(detection[1] * frame.shape[0]) w = int(detection[2] * frame.shape[1])
h = int(detection[3] * frame.shape[0])


# Coordinates of the bounding box x = center_x - w // 2
y = center_y - h // 2

boxes.append([x, y, w, h]) confidences.append(float(confidence)) class_ids.append(class_id)

# Non-maxima suppression to avoid overlapping bounding boxes indexes = cv2.dnn.NMSBoxes(boxes, confidences, 0.5, 0.4)

# Draw bounding boxes on the frame
if len(indexes) > 0: # Make sure there are valid detections for i in indexes.flatten(): # Flatten the index array
x, y, w, h = boxes[i]
label = str(classes[class_ids[i]])
color = (0, 255, 0) # Green for the bounding box cv2.rectangle(frame, (x, y), (x + w, y + h), color, 2)
cv2.putText(frame, label, (x, y - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.9, color, 2)


# Display the frame with the detected objects cv2.imshow("Traffic Analysis", frame)

# Break the loop with 'q' key
if cv2.waitKey(1) & 0xFF == ord('q'): break
# Release the capture object and close all OpenCV windows cap.release()
cv2.destroyAllWindows()
